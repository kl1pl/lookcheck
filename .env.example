# Токен бота от @BotFather
BOT_TOKEN=

# Режим источников данных: demo (работает без API, встроенный каталог) | live (реальные маркетплейсы)
PROVIDER_MODE=demo

# Ozon Seller API (только для live-режима, нужен ИНН)
OZON_CLIENT_ID=
OZON_API_KEY=

# Wildberries: токен партнёра (только для live-режима, нужен ИНН)
WB_API_TOKEN=

# AliExpress Open Platform — работает физлицу БЕЗ ИНН (рекомендую)
AE_APP_KEY=
AE_APP_SECRET=

# БД: локальный SQLite (по умолчанию) или memory
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# Лимиты
DAILY_LIMIT_FREE=8
PREMIUM_DAILY_LIMIT=1000

# Кэш поиска, секунд
SEARCH_CACHE_TTL=600

# Интервал проверки цен избранного, минут
PRICE_WATCH_INTERVAL_MIN=30